rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─── /users ───────────────────────────────────────────────────────────────
    //
    // Lecture    : tout utilisateur authentifié (nécessaire pour lister les
    //              bénévoles à l'inscription et les élèves d'un bénévole).
    // Création   : uniquement son propre document, rôle obligatoire et valide.
    // Mise à jour: son propre document, mais le rôle ne peut plus être changé.
    // Suppression: uniquement son propre document.
    match /users/{userId} {
      allow read: if isAuth();

      allow create: if isOwner(userId)
        && request.resource.data.role in ['eleve', 'benevole'];

      allow update: if isOwner(userId)
        // Interdire tout changement de rôle après création
        && request.resource.data.role == resource.data.role;

      allow delete: if isOwner(userId);
    }

    // Conversations : l'ID est toujours "uid1_uid2" (UIDs triés, alphanumériques).
    match /conversations/{conversationId} {
      // get  = lecture d'un doc unique (peut être inexistant → resource est null)
      //        on valide via l'ID de conversation.
      allow get: if request.auth != null &&
        request.auth.uid in conversationId.split('_');

      // list = requête avec where() → resource existe toujours, Firestore peut
      //        prouver statiquement que participantsIds contient l'uid
      //        grâce au filtre array-contains utilisé dans la requête.
      allow list: if request.auth != null &&
        request.auth.uid in resource.data.participantsIds;

      // Création : vérification via l'ID ET le champ participantsIds
      allow create: if request.auth != null &&
        request.auth.uid in conversationId.split('_') &&
        request.auth.uid in request.resource.data.participantsIds;

      // Mise à jour (lastMessage, lastMessageAt) : être participant
      allow update: if request.auth != null &&
        request.auth.uid in conversationId.split('_');

      // Messages d'une conversation (sous-collection).
      // conversationId est l'ID du parent (constant pour tous les messages),
      // donc split('_') est évaluable statiquement par Firestore.
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in conversationId.split('_');

        allow create: if request.auth != null &&
          request.auth.uid in conversationId.split('_') &&
          request.auth.uid == request.resource.data.expediteurId;

        // Mise à jour (marquage lu) : être le destinataire uniquement
        allow update: if request.auth != null &&
          request.auth.uid == resource.data.destinataireId;
      }
    }

    // ─── /tasks ───────────────────────────────────────────────────────────────
    //
    // Création   : createurId doit être l'utilisateur courant (empêche
    //              l'usurpation d'identité du créateur).
    // Lecture / mise à jour / suppression : assigné OU créateur.
    match /tasks/{taskId} {
      allow create: if isAuth()
        && request.resource.data.createurId == request.auth.uid;

      allow read, update, delete: if isAuth()
        && (resource.data.assigneeId == request.auth.uid
          || resource.data.createurId == request.auth.uid);
    }

    // ─── /events ──────────────────────────────────────────────────────────────
    //
    // Création   : l'utilisateur doit figurer dans participantsIds.
    // Lecture / mise à jour / suppression : réservé aux participants.
    match /events/{eventId} {
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participantsIds;

      allow read, update, delete: if isAuth()
        && request.auth.uid in resource.data.participantsIds;
    }

    // Événements du calendrier : seuls les participants peuvent lire/écrire
    // Le créateur est toujours inclus dans participantsIds à la création.
    match /calendar_events/{eventId} {
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantsIds;
      allow read, update, delete: if request.auth != null &&
        request.auth.uid in resource.data.participantsIds;
    }
  }
}
