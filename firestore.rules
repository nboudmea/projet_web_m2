rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─── /users ───────────────────────────────────────────────────────────────
    //
    // Lecture    : tout utilisateur authentifié (nécessaire pour lister les
    //              bénévoles à l'inscription et les élèves d'un bénévole).
    // Création   : uniquement son propre document, rôle obligatoire et valide.
    // Mise à jour: son propre document, mais le rôle ne peut plus être changé.
    // Suppression: uniquement son propre document.
    match /users/{userId} {
      allow read: if isAuth();

      allow create: if isOwner(userId)
        && request.resource.data.role in ['eleve', 'benevole'];

      allow update: if isOwner(userId)
        // Interdire tout changement de rôle après création
        && request.resource.data.role == resource.data.role;

      allow delete: if isOwner(userId);
    }

    // ─── /messages ────────────────────────────────────────────────────────────
    //
    // Création   : l'expéditeur doit être l'utilisateur courant.
    // Lecture    : expéditeur ou destinataire.
    // Mise à jour: seul le DESTINATAIRE peut modifier (ex : marquer comme lu).
    // Suppression: expéditeur ou destinataire.
    //
    // NOTE : on sépare create (→ request.resource.data) des autres opérations
    // (→ resource.data) car resource est null à la création.
    match /messages/{messageId} {
      allow create: if isAuth()
        && request.resource.data.expediteurId == request.auth.uid;

      allow read: if isAuth()
        && (resource.data.expediteurId == request.auth.uid
          || resource.data.destinataireId == request.auth.uid);

      // Seul le destinataire peut modifier un message (marquer lu, etc.)
      allow update: if isAuth()
        && resource.data.destinataireId == request.auth.uid;

      allow delete: if isAuth()
        && (resource.data.expediteurId == request.auth.uid
          || resource.data.destinataireId == request.auth.uid);
    }

    // ─── /tasks ───────────────────────────────────────────────────────────────
    //
    // Création   : createurId doit être l'utilisateur courant (empêche
    //              l'usurpation d'identité du créateur).
    // Lecture / mise à jour / suppression : assigné OU créateur.
    match /tasks/{taskId} {
      allow create: if isAuth()
        && request.resource.data.createurId == request.auth.uid;

      allow read, update, delete: if isAuth()
        && (resource.data.assigneeId == request.auth.uid
          || resource.data.createurId == request.auth.uid);
    }

    // ─── /events ──────────────────────────────────────────────────────────────
    //
    // Création   : l'utilisateur doit figurer dans participantsIds.
    // Lecture / mise à jour / suppression : réservé aux participants.
    //
    // NOTE : même séparation create / reste que pour /messages.
    match /events/{eventId} {
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participantsIds;

      allow read, update, delete: if isAuth()
        && request.auth.uid in resource.data.participantsIds;
    }
  }
}

