rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Lecture publique aux authentifiés (nécessaire pour lire la liste des
    // bénévoles lors de l'inscription et les élèves d'un bénévole).
    // Écriture : uniquement son propre document.
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Seuls les participants peuvent lire/écrire les messages
    match /messages/{messageId} {
      allow read, write: if request.auth != null &&
        (resource.data.expediteurId == request.auth.uid ||
         resource.data.destinataireId == request.auth.uid);
    }

    // Tâches : création libre (authentifié), lecture/modif/suppression
    // uniquement pour l'assigné ou le créateur.
    match /tasks/{taskId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null &&
        (resource.data.assigneeId == request.auth.uid ||
         resource.data.createurId == request.auth.uid);
    }

    // Seuls les participants peuvent accéder aux événements (ancienne collection)
    match /events/{eventId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.participantsIds;
    }

    // Événements du calendrier : seuls les participants peuvent lire/écrire
    // Le créateur est toujours inclus dans participantsIds à la création.
    match /calendar_events/{eventId} {
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.participantsIds;
      allow read, update, delete: if request.auth != null &&
        request.auth.uid in resource.data.participantsIds;
    }
  }
}
